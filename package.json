{
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '@voxls/toolpick' build && bun run --filter '@voxls/toolpick-cache-redis' build",
    "lint": "biome check packages/*/src",
    "lint:fix": "biome check --write packages/*/src",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "typescript": "^5.9.3"
  }
}
